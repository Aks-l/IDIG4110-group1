# .env file for data-vm

# Private IP of data-vm on twin-net (stack output private_ips.data-vm).
DATA_VM_IP=192.168.10.173

# Generate once, e.g. with: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=change-me

INGEST_DB_USER=ingest
INGEST_DB_PASSWORD=change-me
INGEST_DB_NAME=ingest_db

TWIN_DB_USER=twin
TWIN_DB_PASSWORD=change-me
TWIN_DB_NAME=twin_db

RULES_DB_USER=rules
RULES_DB_PASSWORD=change-me
RULES_DB_NAME=rules_db

IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=change-me
IDENTITY_DB_NAME=identity_db
