# Base URL for all API calls from the browser. With NEXT_PUBLIC_DATA_SOURCE=api
# and the placeholder endpoints in src/app/api, point this at the Next.js
# server itself so the app runs end to end without a backend.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# "api" sends requests to NEXT_PUBLIC_API_URL; "mock" serves the fixtures in
# src/lib/api directly without any HTTP calls.
NEXT_PUBLIC_DATA_SOURCE=api

# Server-side only. When set, the placeholder routes in src/app/api forward
# every request to this base URL instead of serving fixtures — the swap-in
# point for a backend that implements the documented contract. No code
# changes are needed.
#PLACEHOLDER_API_TARGET=http://localhost:8080/api

# Hybrid mode, also server-side only. When PLACEHOLDER_BACKEND_URL is set,
# the placeholder paths listed in PLACEHOLDER_BACKEND_PATHS are served from
# the real backend (translated onto the frontend contract) while the rest
# keep serving fixtures. Requires the backend stack — docker compose up in
# the repository root. Point at the rules-engine (host port 8083); the
# api-gateway (8084) misroutes the collection paths until its router also
# registers the bare prefixes. See docs/frontend/api.md for details.
#PLACEHOLDER_BACKEND_URL=http://localhost:8083
#PLACEHOLDER_BACKEND_PATHS=/automations,/events
#PLACEHOLDER_BACKEND_HOME_ID=00000000-0000-0000-0000-000000000001
#PLACEHOLDER_BACKEND_TEMPERATURE_ENTITY=00000000-0000-0000-0000-000000000001
